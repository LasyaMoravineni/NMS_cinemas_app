pipeline {

    agent any

    stages {

        stage('Verify Checkout') {
            steps {
                sh '''
                    echo "===== NMS CINEMAS CI/CD ====="
                    echo "Repository:"
                    pwd
                    ls -la
                '''
            }
        }

        stage('Build Backend') {
            steps {
                sh '''
                    cd backend

                    export JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
                    export PATH=$JAVA_HOME/bin:$PATH

                    echo "Java version:"
                    java -version

                    echo "Building Spring Boot backend..."

                    ./mvnw clean package -DskipTests
                '''
            }
        }

    }
}
